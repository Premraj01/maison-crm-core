# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list, or * to allow all (dev only)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ── PostgreSQL (structured data) ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=maison
POSTGRES_PASSWORD=maison
POSTGRES_DB=maison_crm
# Never enable in production — use migrations instead.
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_SSL=false

# ── MongoDB (audit logs, notifications, unstructured data) ────────────────────
MONGO_URI=mongodb://localhost:27017/maison_crm

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# ── Realtime / WebSockets ─────────────────────────────────────────────────────
WS_NAMESPACE=/realtime
WS_PATH=/socket.io
# Allow clients to connect without a JWT (development convenience only).
WS_ALLOW_ANONYMOUS=true
# Set REDIS_URL to fan events out across multiple backend instances.
# Leave empty for a single-instance in-memory adapter.
REDIS_URL=
