# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated list, or * to allow all (dev only)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ── PostgreSQL (structured data) ──────────────────────────────────────────────
POSTGRES_HOST=localhost
# 5432 is the native Homebrew postgres and 5433 is hrms-postgres, so this
# stack publishes 5434.
POSTGRES_PORT=5434
POSTGRES_USER=maison
POSTGRES_PASSWORD=maison
POSTGRES_DB=maison_crm
POSTGRES_LOGGING=false
POSTGRES_SSL=false

# Prisma connects with this single URL — keep it in step with the parts above.
DATABASE_URL=postgresql://maison:maison@localhost:5434/maison_crm?schema=public

# ── MongoDB (audit logs, notifications, unstructured data) ────────────────────
# 27017 is taken by the hrms-mongo container, so this stack publishes 27018.
MONGO_PORT=27018
MONGO_DB=maison_crm
MONGO_URI=mongodb://localhost:27018/maison_crm

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# ── Realtime / WebSockets ─────────────────────────────────────────────────────
WS_NAMESPACE=/realtime
WS_PATH=/socket.io
# Allow clients to connect without a JWT (development convenience only).
WS_ALLOW_ANONYMOUS=true
# Set REDIS_URL to fan events out across multiple backend instances.
# Leave empty for a single-instance in-memory adapter.
REDIS_PORT=6379
REDIS_URL=

# ── Docker ────────────────────────────────────────────────────────────────────
# docker compose reads this same file, so POSTGRES_PORT / MONGO_PORT / REDIS_PORT
# above set BOTH the published host port and the port the app dials. Change one
# value and the two stay in sync — except MONGO_URI, which repeats the port.
