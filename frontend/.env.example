# Backend origin used for REST calls and the WebSocket connection.
VITE_API_URL=http://localhost:3000
VITE_WS_NAMESPACE=/realtime
# Path the REST API is mounted under (API_PREFIX on the backend).
VITE_API_PREFIX=/api
# Public beacon-estates website, used for the "View on site" links on property
# and lead cards. Listings themselves come from the API, shared by both apps.
# Both apps default to Vite's port 8080, so whichever starts second lands on
# 8081 — set this explicitly rather than depending on start order.
VITE_SITE_URL=http://localhost:8081
